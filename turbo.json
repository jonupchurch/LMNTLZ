{
  "$schema": "https://turbo.build/schema.json",

  // Turborepo warns about every variable set on the Vercel project that is not
  // declared here. It is a CACHE-CORRECTNESS mechanism: an undeclared variable
  // does not enter the task hash, so a build could be replayed from cache after
  // that variable changed. Nothing here reads any of them at build time —
  // `build` is `tsc` — but declaring them is what makes the hash honest, and an
  // always-firing warning trains everybody to ignore build warnings, which is
  // worse than the risk it describes.
  //
  // NOTE: turbo.json is JSONC — real `//` comments are fine, but a `"//key":`
  // ENTRY is rejected as an unknown key. That convention works in package.json
  // and not here.
  "globalEnv": [
    "ABLY_API_KEY",
    "CORS_ALLOWED_ORIGINS",
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "GOOGLE_CLIENT_ID",
    "JWT_SIGNING_KEY",
    "NODE_ENV",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_GIT_COMMIT_SHA",
    "VITE_API_BASE_URL",
    "VITE_GOOGLE_CLIENT_ID"
  ],

  // Neon's Vercel integration injects ~13 aliases of the same connection
  // string. This project reads none of them — see `.env.example` — but they are
  // set on the project, so Turbo warns about them. Listed to silence it, NOT
  // because anything consumes them. Delete a row the day the matching variable
  // is removed from Vercel.
  //
  // ONE EXCEPTION, verified against the live bundle on 2026-07-29:
  // `VITE_NEON_AUTH_URL` IS consumed — not by our code, by Vite. `lib/api.ts`
  // reads `import.meta.env['VITE_API_BASE_URL']` in brackets rather than with a
  // dot, because `noPropertyAccessFromIndexSignature` requires it, and bracket
  // access is not statically replaceable — so Vite emits the whole env object
  // instead, and every VITE_-prefixed variable on the project lands in a file
  // every visitor downloads. Today that is `VITE_API_BASE_URL`,
  // `VITE_GOOGLE_CLIENT_ID` (both public by design) and this one, whose value is
  // a Neon Auth endpoint — public by design too, and unused, since auth is owned
  // in-house. **Nothing is leaking.** The hazard is the mechanism: an integration
  // that adds a VITE_-prefixed variable publishes it with no code change and no
  // warning. Neon's belongs on the API project, not the client's.
  "globalPassThroughEnv": [
    "PGHOST",
    "PGHOST_UNPOOLED",
    "PGUSER",
    "PGDATABASE",
    "PGPASSWORD",
    "POSTGRES_URL",
    "POSTGRES_URL_NON_POOLING",
    "POSTGRES_USER",
    "POSTGRES_HOST",
    "POSTGRES_PASSWORD",
    "POSTGRES_DATABASE",
    "POSTGRES_URL_NO_SSL",
    "POSTGRES_PRISMA_URL",
    "NEON_PROJECT_ID",
    "NEON_AUTH_BASE_URL",
    "VITE_NEON_AUTH_URL",

    // The two Paddle keys are here for a DIFFERENT reason from the Neon rows
    // above, and the distinction is the whole point of this list. Those are set
    // on Vercel and read by nothing; these are set on a DEVELOPER'S MACHINE and
    // read by nothing either — `PADDLE_SANDBOX_API_KEY` is consumed by
    // `.mcp.json` at the repo root, which is Claude Code tooling, not a build
    // input. Neither is on any Vercel project today.
    //
    // They belong in passThrough rather than `globalEnv` precisely BECAUSE they
    // are credentials: a key rotation must not invalidate every cached build,
    // and Paddle expires keys every 90 days, so `globalEnv` would throw the
    // whole cache away four times a year for a value no build ever reads.
    //
    // `PADDLE_LIVE_API_KEY` moves UP to `globalEnv` the day real payment code
    // reads it on the server — see `.env.example`.
    "PADDLE_SANDBOX_API_KEY",
    "PADDLE_LIVE_API_KEY"
  ],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    }
  }
}
