{
  "$schema": "https://turbo.build/schema.json",

  // Turborepo warns about every variable set on the Vercel project that is not
  // declared here. It is a CACHE-CORRECTNESS mechanism: an undeclared variable
  // does not enter the task hash, so a build could be replayed from cache after
  // that variable changed. Nothing here reads any of them at build time —
  // `build` is `tsc` — but declaring them is what makes the hash honest, and an
  // always-firing warning trains everybody to ignore build warnings, which is
  // worse than the risk it describes.
  //
  // NOTE: turbo.json is JSONC — real `//` comments are fine, but a `"//key":`
  // ENTRY is rejected as an unknown key. That convention works in package.json
  // and not here.
  "globalEnv": [
    "CORS_ALLOWED_ORIGINS",
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "GOOGLE_CLIENT_ID",
    "JWT_SIGNING_KEY",
    "NODE_ENV",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_GIT_COMMIT_SHA",
    "VITE_API_BASE_URL"
  ],

  // Neon's Vercel integration injects ~13 aliases of the same connection
  // string. This project reads none of them — see `.env.example` — but they are
  // set on the project, so Turbo warns about them. Listed to silence it, NOT
  // because anything consumes them. Delete a row the day the matching variable
  // is removed from Vercel.
  "globalPassThroughEnv": [
    "PGHOST",
    "PGHOST_UNPOOLED",
    "PGUSER",
    "PGDATABASE",
    "PGPASSWORD",
    "POSTGRES_URL",
    "POSTGRES_URL_NON_POOLING",
    "POSTGRES_USER",
    "POSTGRES_HOST",
    "POSTGRES_PASSWORD",
    "POSTGRES_DATABASE",
    "POSTGRES_URL_NO_SSL",
    "POSTGRES_PRISMA_URL",
    "NEON_PROJECT_ID",
    "NEON_AUTH_BASE_URL",
    "VITE_NEON_AUTH_URL"
  ],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    }
  }
}
