# Spec-Kit transient state — a pointer to the active feature, not project data.
# NOTE: specs/ is deliberately NOT ignored. In this project the specs are the
# source of truth and belong in history. (The ai-tools toolkit repo ignores
# specs/ because it ships the engine, not any one project's state.)
.specify/feature.json

# Machine-local Claude Code settings (permissions/paths, never shared).
# Personal overrides like defaultMode belong here, not in settings.json.
.claude/settings.local.json

# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo

# Turborepo / Vitest local caches
.turbo/
coverage/
.vitest-cache/

# Vercel (from feature 005 onward)
.vercel/

# NOTE: `*.generated.ts` is deliberately NOT ignored. The emitted roster and the
# content stamp are COMMITTED, and CI re-runs the build and fails if they differ
# (feature 001, T041). Ignoring them would remove the only check that the
# committed output still matches the authored workbook.

# Secrets
.env*

# ...except the template, which carries the NAMES and never the values. It is
# the only record of what a fresh machine needs, and leaving it ignored means
# the answer lives in one person's head.
!.env.example
!.env.example

# OS
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Editors
.vscode/
.idea/
*.swp
