# Copy to `.env.local` and fill in. `.env.local` is gitignored and stays that way.
#
# NOTHING IN HERE IS A VALUE. This file records which variables exist and what
# each is for; the values live on your machine and in Vercel's environment
# settings, and never in a chat transcript or a commit.

# ---------------------------------------------------------------------------
# Database — feature 005 T002
# ---------------------------------------------------------------------------
# Neon, pooled connection string. Neon is the database for EVERY environment,
# tests included. Take it from the Neon dashboard's "Pooled connection" tab —
# the direct one exhausts connections under serverless functions.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Identity — feature 005 T012 onward
# ---------------------------------------------------------------------------
# Google OAuth **web application** client. Only the ID is needed: we verify
# Google's ID tokens against their published JWKS rather than running an OAuth
# code exchange, so there is no client secret on the server and no credential of
# any kind in the client build.
GOOGLE_CLIENT_ID=

# The signing key for OUR OWN tokens — not Google's. Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating this invalidates every live session, which is the intended blast
# radius for a suspected leak.
JWT_SIGNING_KEY=
