# Copy to `.env.local` and fill in. `.env.local` is gitignored and stays that way.
#
# NOTHING IN HERE IS A VALUE. This file records which variables exist and what
# each is for; the values live on your machine and in Vercel's environment
# settings, and never in a chat transcript or a commit.

# ---------------------------------------------------------------------------
# Database — feature 005 T002
# ---------------------------------------------------------------------------
# Neon, POOLED connection string — the host contains "-pooler". Neon is the
# database for EVERY environment, tests included. The direct string works fine
# locally and exhausts the connection limit under serverless concurrency, which
# is the worst failure schedule: it passes every test and breaks under traffic.
DATABASE_URL=

# Neon, DIRECT connection string. MIGRATIONS ONLY, and the opposite of the rule
# above on purpose. Neon's pooler is PgBouncer in transaction mode, where a
# connection returns to the pool at the end of each transaction — so anything
# expecting to outlive one, like a migration runner's advisory lock, silently
# stops meaning what it says. Neon hands out both strings for exactly this.
#
# Neon pastes this into your env block automatically as DATABASE_URL_UNPOOLED.
# It also pastes ~13 PG*/POSTGRES_* aliases that this project never reads —
# delete them. A variable nothing reads is a variable nobody maintains.
DATABASE_URL_UNPOOLED=

# ---------------------------------------------------------------------------
# Identity — feature 005 T012 onward
# ---------------------------------------------------------------------------
# Google OAuth **web application** client. Only the ID is needed: we verify
# Google's ID tokens against their published JWKS rather than running an OAuth
# code exchange, so there is no client secret on the server and no credential of
# any kind in the client build.
GOOGLE_CLIENT_ID=

# The signing key for OUR OWN tokens — not Google's. Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating this invalidates every live session, which is the intended blast
# radius for a suspected leak.
JWT_SIGNING_KEY=

# ---------------------------------------------------------------------------
# The origin boundary — two projects, two variables
# ---------------------------------------------------------------------------
# `apps/api` and `apps/client` are separate Vercel projects, so the browser is
# always making a cross-origin request. These two variables are the only thing
# joining them, and each is set on ONE project.
#
# --- set on the API project ---
#
# Comma-separated, exact-match, no wildcards. `*` and `null` are DROPPED rather
# than honoured (`apps/api/src/cors.ts`) — they are the two values that turn an
# allowlist into an open door, and neither ever arrives on purpose.
#
# UNSET IN PRODUCTION MEANS NO BROWSER CAN CALL THE API. There is no default and
# that is deliberate: defaulting to localhost would make any developer with
# something on port 5173 a permitted caller of the live API. `pnpm dev` supplies
# the local origins from `src/dev.ts`, which never ships to Vercel — so nothing
# needs to be set here to work on a laptop.
#
#   CORS_ALLOWED_ORIGINS=https://lmntlz.vercel.app
CORS_ALLOWED_ORIGINS=

# --- set on the CLIENT project, at BUILD time ---
#
# Vite inlines anything prefixed `VITE_` into the bundle, so this is baked in
# when the client is built and cannot be changed by an env edit afterwards — a
# change here needs a redeploy, not a restart.
#
# EMPTY MEANS SAME-ORIGIN, which is right for a bundle that might be served from
# anywhere and wrong for the two-project deployment. Set it to the API's origin,
# with no trailing slash and no `/v1` — `apps/client/src/lib/api.ts` adds that.
#
#   VITE_API_BASE_URL=https://lmntlz.vercel.app
VITE_API_BASE_URL=
